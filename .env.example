# ========================================
# STUDENT REMINDER APP — ENVIRONMENT SETUP
#
# Copy this file to `.env` and fill in your
# local MySQL credentials:
#
#   cp .env.example .env   (Linux/macOS)
#   copy .env.example .env (Windows)
#
# NEVER commit the real `.env` file.
# This template contains placeholders only.
# ========================================

# Server
PORT=3000

# Database (required for Phase A2+ MySQL connection)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=student_reminder
DB_CONNECTION_LIMIT=10

# CORS / Origin Protection (required from Phase B)
# Set to your frontend origin (e.g., http://localhost:3000 or your deployed URL)
# Used for CORS allowlist AND CSRF Origin validation
ALLOWED_ORIGIN=http://localhost:3000